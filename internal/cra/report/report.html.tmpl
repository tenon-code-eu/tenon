<!DOCTYPE html>
<html lang="{{.Lang}}">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{t "dossier.title"}} {{.D.Product.Name}} {{.D.Product.Version}}</title>
<style>
body { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; color: #1a1a1a; background: #fff; margin: 2rem auto; max-width: 64rem; padding: 0 1rem; line-height: 1.45; font-size: 14px; }
h1 { font-size: 1.6rem; margin-bottom: .5rem; }
h2 { font-size: 1.2rem; border-bottom: 1px solid #ccc; padding-bottom: .2rem; margin-top: 2rem; }
h3 { font-size: 1rem; margin-top: 1.2rem; }
dl.meta { display: grid; grid-template-columns: max-content 1fr; gap: .2rem 1rem; }
dl.meta dt { font-weight: 600; }
dl.meta dd { margin: 0; overflow-wrap: anywhere; }
table { border-collapse: collapse; width: 100%; margin: .5rem 0; }
th, td { border: 1px solid #ccc; padding: .25rem .4rem; text-align: left; vertical-align: top; overflow-wrap: anywhere; }
th { background: #f3f3f3; }
code, .mono { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: .9em; }
.banner { padding: .6rem .8rem; margin: .6rem 0; border-radius: 4px; border: 1px solid; }
.banner.warn { background: #fff6e0; border-color: #c88a00; }
.banner.info { background: #e8f0fd; border-color: #1e5ac8; }
.disclaimer { font-style: italic; color: #444; }
.muted { color: #666; }
.overdue { color: #8a1010; font-weight: 600; }
pre { white-space: pre-wrap; overflow-wrap: anywhere; margin: 0; }
@media print {
  body { margin: 0; max-width: none; font-size: 11px; }
  tr, .banner { break-inside: avoid; page-break-inside: avoid; }
  thead { display: table-header-group; }
  h2, h3 { break-after: avoid; page-break-after: avoid; }
}
</style>
</head>
<body>
<header>
<h1>{{t "dossier.title"}}</h1>
{{with .D}}<dl class="meta">
<dt>{{t "dossier.label.product"}}</dt><dd>{{.Product.Name}}</dd>
<dt>{{t "dossier.label.version"}}</dt><dd>{{.Product.Version}}</dd>
<dt>{{t "dossier.label.manufacturer"}}</dt><dd>{{.Product.Manufacturer}}</dd>
<dt>{{t "dossier.label.contact"}}</dt><dd>{{.Product.SecurityContact}}</dd>
<dt>{{t "dossier.label.category"}}</dt><dd>{{.Product.Category}}</dd>
<dt>{{t "dossier.label.support_end"}}</dt><dd>{{day .Product.SupportEnd}}</dd>
<dt>{{t "dossier.label.generated"}}</dt><dd>{{date .GeneratedAt}}</dd>
</dl>
<p class="disclaimer">{{t "dossier.disclaimer"}}</p>
</header>

<section id="sboms">
<h2>{{t "dossier.sec.sboms"}}</h2>
{{with .BOMs}}<table>
<thead><tr><th>{{t "dossier.col.file"}}</th><th>{{t "dossier.col.spec"}}</th><th>{{t "dossier.col.generator"}}</th><th>{{t "dossier.col.date"}}</th><th>{{t "dossier.col.components"}}</th></tr></thead>
{{range .}}<tr><td class="mono">{{.File}}</td><td>{{.SpecVersion}}</td><td>{{.Generator}}</td><td>{{if .Timestamp.IsZero}}—{{else}}{{date .Timestamp}}{{end}}</td><td>{{.Components}}</td></tr>
{{end}}</table>{{else}}<p class="muted">{{t "dossier.none"}}</p>{{end}}
</section>

<section id="scan">
<h2>{{t "dossier.sec.scan"}}</h2>
{{with .Scan}}<p>{{t "dossier.scan.summary" .SBOMs .Components .Open .ToVerify .NotAffected .Fixed .Conflicts .Unchecked (dayz .DBDate)}}</p>
{{with .Findings}}<table>
<thead><tr><th>{{t "dossier.col.id"}}</th><th>{{t "dossier.col.component"}}</th><th>{{t "dossier.col.status"}}</th><th>{{t "dossier.col.summary"}}</th></tr></thead>
{{range .}}<tr><td class="mono">{{.ID}}</td><td class="mono">{{if .Component.PURL}}{{.Component.PURL}}{{else}}{{.Component.Name}}@{{.Component.Version}}{{end}}</td><td>{{tk "dossier.st." .Status}}{{if .Conflict}} — {{t "dossier.conflict"}}{{end}}</td><td>{{.Summary}}</td></tr>
{{end}}</table>{{else}}<p class="muted">{{t "dossier.none"}}</p>{{end}}
{{with .UncheckedComponents}}<h3>{{t "dossier.sec.unchecked"}}</h3>
<ul>{{range .}}<li class="mono">{{.Name}}@{{.Version}}</li>{{end}}</ul>{{end}}
{{else}}<div class="banner warn">{{t "dossier.scan.none"}}</div>{{end}}
</section>

<section id="reports">
<h2>{{t "dossier.sec.reports"}}</h2>
{{range .Reports}}<h3><span class="mono">{{.ID}}</span> ({{tk "dossier.kind." .Kind}}) — {{.Summary}}</h3>
<table>
<thead><tr><th>{{t "dossier.col.step"}}</th><th>{{t "dossier.col.due"}}</th><th>{{t "dossier.col.done"}}</th><th>{{t "dossier.col.status"}}</th></tr></thead>
{{range .Deadlines}}<tr><td>{{tk "dossier.step." .Step}}</td><td>{{opt .Due}}</td><td>{{opt .Done}}</td><td{{if eq .Status "overdue"}} class="overdue"{{end}}>{{tk "dossier.dl." .Status}}</td></tr>
{{end}}</table>
{{else}}<p class="muted">{{t "dossier.none"}}</p>{{end}}
</section>

<section id="docs">
<h2>{{t "dossier.sec.docs"}}</h2>
{{range .Docs}}<h3 class="mono">{{.Name}}</h3>
<pre>{{.Content}}</pre>
{{else}}<p class="muted">{{t "dossier.none"}}</p>{{end}}
</section>
{{end}}
</body>
</html>
